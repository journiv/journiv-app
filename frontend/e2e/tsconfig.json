{
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    // Playwright resolves tsconfig paths from the nearest tsconfig to the spec,
    // so this block is what makes `@/api/generated` resolve at runtime as well
    // as under `tsc -b`.
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
