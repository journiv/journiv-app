{
  "name": "journiv-frontend-validation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome lint .",
    "lint:design": "node scripts/check-design-system.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "node scripts/check-design-system.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps chromium",
    "verify": "npm run format:check && npm run lint && npm run lint:design && npm run typecheck && npm test && npm run build && npm run api:check",
    "api:pull": "node scripts/pull-openapi.mjs",
    "api:generate": "openapi-ts",
    "api:check": "node scripts/check-generated.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@tanstack/react-query": "5.102.2",
    "@tanstack/react-router": "1.170.32",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "idb": "8.0.3",
    "lucide-react": "1.34.0",
    "quill": "2.0.3",
    "react": "19.2.3",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "fake-indexeddb": "6.2.5",
    "jsdom": "28.0.0",
    "shadcn": "4.19.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": "11.17.0"
  }
}
