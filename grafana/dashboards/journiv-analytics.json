      "title": "🔥 Current Streak",
      "type": "stat",
      "targets": [
        {
          "datasource": "Journiv",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH writing_days AS (\n  SELECT DISTINCT CAST(m.logged_date_tz AS TEXT) AS day\n  FROM entry e\n  JOIN moment m ON m.id = e.moment_id\n  WHERE e.is_draft = false\n    AND e.user_id = '${USER_ID}'\n), day_parts AS (\n  SELECT\n    day,\n    CAST(SUBSTR(day, 1, 4) AS INTEGER) AS year_num,\n    CAST(SUBSTR(day, 6, 2) AS INTEGER) AS month_num,\n    CAST(SUBSTR(day, 9, 2) AS INTEGER) AS day_num\n  FROM writing_days\n), day_numbers AS (\n  SELECT\n    day,\n    day_num\n      + CAST((153 * (month_num + 12 * leap_month_adj - 3) + 2) / 5 AS INTEGER)\n      + 365 * (year_num + 4800 - leap_month_adj)\n      + CAST((year_num + 4800 - leap_month_adj) / 4 AS INTEGER)\n      - CAST((year_num + 4800 - leap_month_adj) / 100 AS INTEGER)\n      + CAST((year_num + 4800 - leap_month_adj) / 400 AS INTEGER)\n      - 32045 AS day_serial\n  FROM (\n    SELECT\n      day,\n      year_num,\n      month_num,\n      day_num,\n      CAST((14 - month_num) / 12 AS INTEGER) AS leap_month_adj\n    FROM day_parts\n  ) p\n), ordered_days AS (\n  SELECT day_serial, ROW_NUMBER() OVER (ORDER BY day_serial DESC) AS seq\n  FROM day_numbers\n), streak_groups AS (\n  SELECT day_serial, seq, day_serial + seq AS streak_group\n  FROM ordered_days\n), streaks AS (\n  SELECT MAX(day_serial) AS streak_end_serial, COUNT(*) AS streak_len\n  FROM streak_groups\n  GROUP BY streak_group\n)\nSELECT COALESCE((\n  SELECT streak_len\n  FROM streaks\n  WHERE streak_end_serial = (SELECT MAX(day_serial) FROM day_numbers)\n  LIMIT 1\n), 0) AS \"Current Streak (days)\"",
          "refId": "A"
        }
      ]
    },
