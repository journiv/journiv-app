          "rawSql": "SELECT\n  a.name AS activity,\n  COUNT(*) AS times_logged\nFROM moment_mood_activity mma\nJOIN activity a ON a.id = mma.activity_id\nJOIN moment m ON m.id = mma.moment_id\nWHERE mma.activity_id IS NOT NULL\n  AND $__timeFilter(m.logged_at_utc)\nGROUP BY a.name\nORDER BY times_logged DESC\nLIMIT 20",
