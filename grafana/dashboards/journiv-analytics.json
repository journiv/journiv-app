        {
          "datasource": "Journiv",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  j.title AS journal,\n  COUNT(e.id) AS entries,\n  COALESCE(SUM(e.word_count), 0) AS total_words,\n  CASE WHEN COUNT(e.id) > 0\n    THEN ROUND((1.0 * COALESCE(SUM(e.word_count), 0)) / COUNT(e.id), 1)\n    ELSE 0\n  END AS avg_words_per_entry,\n  MAX(m.logged_at_utc) AS last_entry\nFROM journal j\nLEFT JOIN entry e ON e.journal_id = j.id AND e.is_draft = false AND e.user_id = '${USER_ID}'\nLEFT JOIN moment m ON m.id = e.moment_id\nWHERE j.user_id = '${USER_ID}'\n  AND (m.id IS NULL OR $__timeFilter(m.logged_at_utc))\nGROUP BY j.id, j.title\nORDER BY entries DESC, j.title ASC",
          "refId": "A"
        }
