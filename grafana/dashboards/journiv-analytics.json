          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  a.name AS activity,\n  ROUND(AVG(mo.score)::numeric, 2) AS avg_mood_score\nFROM moment_mood_activity mma\nJOIN activity a ON a.id = mma.activity_id\nJOIN moment m ON m.id = mma.moment_id\nJOIN mood mo ON mo.id = m.primary_mood_id\nWHERE mma.activity_id IS NOT NULL\n  AND $__timeFilter(m.logged_at_utc)\nGROUP BY a.name\nHAVING COUNT(*) >= 3\nORDER BY avg_mood_score DESC\nLIMIT 15",
