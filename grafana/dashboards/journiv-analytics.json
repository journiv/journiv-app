          "rawQuery": true,
          "rawSql": "SELECT\n  CASE WHEN COUNT(*) > 0\n    THEN ROUND(100.0 * SUM(CASE WHEN gl.status = 'success' THEN 1 ELSE 0 END) / COUNT(*), 1)\n    ELSE 0\n  END AS \"Completion %\"\nFROM goal_log gl\nWHERE $__timeFilter(gl.created_at)",
