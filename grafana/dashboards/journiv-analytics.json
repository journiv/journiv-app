          "rawSql": "SELECT\n  $__timeGroup(gl.created_at, '1d') AS time,\n  g.title AS metric,\n  SUM(CASE WHEN gl.status = 'success' THEN 1 ELSE 0 END) AS value\nFROM goal_log gl\nJOIN goal g ON g.id = gl.goal_id\nWHERE $__timeFilter(gl.created_at)\n  AND g.archived_at IS NULL\nGROUP BY 1, g.title\nORDER BY 1 ASC",
          "refId": "A"
