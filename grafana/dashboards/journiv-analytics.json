          "rawSql": "SELECT\n  j.title AS journal,\n  j.entry_count AS entries,\n  j.total_words AS total_words,\n  CASE WHEN j.entry_count > 0\n    THEN ROUND(j.total_words::numeric / j.entry_count, 1)\n    ELSE 0\n  END AS avg_words_per_entry,\n  j.last_entry_at AS last_entry\nFROM journal j\nORDER BY j.entry_count DESC",
